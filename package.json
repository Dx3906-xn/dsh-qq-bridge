{
  "name": "dsh-qq-bridge",
  "version": "0.1.0",
  "description": "A QQ channel for DSH companion agents: a backend-pluggable bridge over OneBot 11 (NapCat / LLBot), one DSH session per conversation, and a tool surface small enough to hand to an agent that reads untrusted text.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qq",
    "onebot",
    "napcat",
    "companion",
    "agent"
  ],
  "scripts": {
    "test": "node test/run-suites.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dx3906-xn/dsh-qq-bridge.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": false },
    "@deepseek-ai/dsh-agent": { "optional": false },
    "@deepseek-ai/dsh-llm": { "optional": false },
    "@deepseek-ai/dsh-session": { "optional": false },
    "@deepseek-ai/dsh-session-persistence": { "optional": false },
    "@deepseek-ai/dsh-tools": { "optional": false },
    "@deepseek-ai/schemastery": { "optional": false }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}